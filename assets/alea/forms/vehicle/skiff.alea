// Skiff — a small hover craft seen from above, nose at the top (y = 0).
// Read as a relief and mirrored underneath; the field is the height, 0–1.

work Skiff(depth = 0) {
  let half   = 0.05 + 0.2 * y
  let body   = (1 - smoothstep(-0.015, 0.015, abs(x - 0.5) - half))
               * smoothstep(0.03, 0.08, y) * (1 - smoothstep(0.9, 0.96, y))
  let canopy = circle(0.5, ~between(0.32, 0.42), 0.12, 0.04)
  let fins   = rect(0.5, 0.86, ~between(0.6, 0.8), 0.06, 0, 0.01)
  field shape = clamp(body * (0.35 + 0.3 * (1 - abs(x - 0.5) * 4)) + canopy * 0.4 + fins * 0.15, 0, 1)
  render sculpture(shape, side: ~between(5, 7), relief: 0.22)

  render image(body + canopy * 2 + stripes(count: 2, angle: 90, softness: 0.1) * 0.2,
               range: [0, 3], palette: ["#e8e8e4", "#ffffff", "#ff7a30", "#203040"])
  render image(fins * 2 + step(0.92, y) * body, range: [0, 1], palette: ["#000000", "#40e0ff"])
}
